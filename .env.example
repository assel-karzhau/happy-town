# Copy this file to .env and replace the local-only password.
POSTGRES_USER=happy_town
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=happy_town
POSTGRES_PORT=5432
DATABASE_URL=postgresql://happy_town:change_me_for_local_development@localhost:5432/happy_town?schema=public

# For a future hosted PostgreSQL provider, DATABASE_URL may be pooled while
# DIRECT_URL points to a direct connection used by migrations.
DIRECT_URL=

# Auth.js. Generate a long random value outside local development.
AUTH_SECRET=replace_with_at_least_32_random_characters
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_ROLE_SWITCHER=false

# Deterministic development accounts created by prisma/seed.ts.
# The 12-digit identifiers below are synthetic test values, not real IINs.
# Replace every credential outside local development.
SEED_ADMIN_IIN=000000000001
SEED_ADMIN_EMAIL=admin@happytown.local
SEED_ADMIN_PASSWORD=HappyTown-Admin-2026!
SEED_TEACHER_IIN=000000000002
SEED_TEACHER_EMAIL=teacher@happytown.local
SEED_TEACHER_PASSWORD=HappyTown-Teacher-2026!
SEED_PARENT_IIN=000000000003
SEED_PARENT_EMAIL=parent@happytown.local
SEED_PARENT_PASSWORD=HappyTown-Parent-2026!

# Seed is blocked when NODE_ENV=production unless this explicit switch is set.
ALLOW_PRODUCTION_SEED=false
