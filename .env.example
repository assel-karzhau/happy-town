# Copy this file to .env and fill every required value locally.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENABLE_DEMO_ROLE_SWITCHER=

# Local seed accounts created by prisma/seed.ts. Do not commit their values.
SEED_ADMIN_IIN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_TEACHER_IIN=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_PARENT_IIN=
SEED_PARENT_EMAIL=
SEED_PARENT_PASSWORD=

# With this switch set to true, seed creates only the first production ADMIN.
# Leave it false for local demo seeding.
ALLOW_PRODUCTION_SEED=false
