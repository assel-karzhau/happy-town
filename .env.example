# Copy this file to .env and replace the local-only password.
POSTGRES_USER=happy_town
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=happy_town
POSTGRES_PORT=5432
DATABASE_URL=postgresql://happy_town:change_me_for_local_development@localhost:5432/happy_town?schema=public

# For a future hosted PostgreSQL provider, DATABASE_URL may be pooled while
# DIRECT_URL points to a direct connection used by migrations.
DIRECT_URL=

# Seed is blocked when NODE_ENV=production unless this explicit switch is set.
ALLOW_PRODUCTION_SEED=false
